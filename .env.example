# ---------- Banco de dados (MongoDB, um por estabelecimento) ----------
# MongoDB Atlas: Connect > Drivers > copie a string e troque <db_password>.
# O nome do banco vem depois da barra e é obrigatório para o Prisma.
DATABASE_URL="mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/cardapio?retryWrites=true&w=majority"

# ---------- Endereço público do cardápio (usado no QR Code e no e-mail) ----------
APP_URL="http://localhost:3000"

# ---------- Fotos dos lanches ----------
# Em produção (Vercel) as fotos vão para o Vercel Blob — conecte um Blob Store
# ao projeto e a Vercel injeta esta variável sozinha.
# Deixe vazio no computador: sem token, as fotos são gravadas em public/uploads/.
BLOB_READ_WRITE_TOKEN=""

# ---------- Acesso inicial do painel admin (usado só no `npm run db:seed`) ----------
ADMIN_EMAIL="dono@hamburgueria.com.br"
ADMIN_PASSWORD="mudar123"

# ---------- E-mail para recuperação de senha ----------
# Se não preencher, o link de recuperação é gravado em .mail-dev.log (modo teste).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Cardapio Digital <nao-responda@hamburgueria.com.br>"
